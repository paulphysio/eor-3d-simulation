# Environment Configuration Example
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_NAME=Niger Delta EOR Simulator
NEXT_PUBLIC_APP_VERSION=1.0.0

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# API Configuration (Optional - for future extensions)
# NEXT_PUBLIC_API_URL=https://api.example.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false

# SEO
# Your public domain (no trailing slash). On Vercel this is detected automatically,
# but set it if you add a custom domain so canonical URLs and the sitemap use it.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Search-engine ownership verification codes (from Google Search Console / Bing Webmaster Tools)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
